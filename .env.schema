# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public
# @type=enum(production, development, test)
NODE_ENV="development"

# Public URL of the website, used for canonical URLs and metadata.
# @sensitive=false
# @type=url(noTrailingSlash=true)
# @example="http://localhost:3000"
SITE_URL="http://localhost:3000"

# Public URL of the Umami analytics instance.
# @optional @sensitive=false
# @type=url(noTrailingSlash=true)
# @docs(https://umami.is/docs)
UMAMI_URL=

# Umami website identifier used for analytics tracking.
# @optional @sensitive=false
# @type=uuid
UMAMI_WEBSITE_ID=
